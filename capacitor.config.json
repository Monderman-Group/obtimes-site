{
  "appId": "com.obtimes.reader",
  "appName": "On Borrowed Times",
  "webDir": "mobile/www",
  "backgroundColor": "#fafbf7",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#191b19",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK",
      "hidden": false,
      "animation": "NONE"
    }
  }
}
